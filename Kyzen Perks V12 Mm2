--==================================================
-- AUTO PICK (gun drop watcher)
--==================================================
local function considerDrop(inst, fresh)
	if not (inst:IsA("Tool") or inst:IsA("BasePart") or inst:IsA("Model")) then
		return
	end
	if not isGunName(inst.Name) then
		return
	end
	if inst:IsA("Model") and inst:FindFirstChildOfClass("Humanoid") then
		return
	end
	if isPlayerOwned(inst) then
		return
	end
	GunDrops[inst] = true
	if fresh and inst:IsA("Tool") then
		setPending()
	end
end

local function startDropWatch()
	if next(DropConns) then
		return
	end
	for _, inst in ipairs(Workspace:GetDescendants()) do
		considerDrop(inst, false)
	end
	DropConns.Added = Workspace.DescendantAdded:Connect(function(inst)
		considerDrop(inst, true)
	end)
	DropConns.Removing = Workspace.DescendantRemoving:Connect(function(inst)
		GunDrops[inst] = nil
	end)
end

local function stopDropWatch()
	for k, conn in pairs(DropConns) do
		conn:Disconnect()
		DropConns[k] = nil
	end
	GunDrops = {}
end

-- Priority: 1) last Sheriff death position (unless a newer gun-holder death exists)
--           2) last known gun-holder position  3) detected gun drop
local function getTargetPosition()
	if not RS.PendingDrop then
		return nil
	end
	local sPos, gPos = RS.LastSheriffDeathPosition, RS.GunHolderDeathPosition
	if sPos and (not gPos or RS.SheriffDeathTime >= RS.GunHolderDeathTime) then
		return sPos, "Sheriff death position"
	elseif gPos then
		return gPos, "Gun-holder death position"
	end
	if RS.LastGunHolderPos then
		return RS.LastGunHolderPos, "Last gun-holder position"
	end
	for inst in pairs(GunDrops) do
		if inst.Parent then
			local part = getDropPart(inst)
			if part then
				return part.Position, "Detected gun drop"
			end
		end
	end
	return nil
end

local function scorePart(part, pos)
	if part.Size.Magnitude > 20 or not part.CanTouch then
		return -1
	end
	local score, evidence = 0, false
	local tool = part:FindFirstAncestorOfClass("Tool")
	local model = part:FindFirstAncestorOfClass("Model")

	if isGunName(part.Name) or (tool and isGunName(tool.Name)) or (model and isGunName(model.Name)) then
		score += 6
		evidence = true
	end
	if tool then
		score += 4
		evidence = true
	end
	if model then
		local n = 0
		for _, child in ipairs(model:GetChildren()) do
			n += 1
			if n > 30 then break end
			if isGunName(child.Name) then
				score += 3
				evidence = true
				break
			end
		end
	end
	for k in pairs(part:GetAttributes()) do
		if isGunName(k) then
			score += 3
			evidence = true
			break
		end
	end
	if part:FindFirstChildOfClass("TouchTransmitter") then
		score += 2
	end
	if not evidence then
		return -1
	end
	return score - (part.Position - pos).Magnitude / 25
end

local function findPickup(pos)
	-- 1) known drop instances near the target
	local best, bestScore = nil, -math.huge
	for inst in pairs(GunDrops) do
		if inst.Parent then
			local p = getDropPart(inst)
			if p then
				local dist = (p.Position - pos).Magnitude
				if dist <= CONFIG.PickRadius * 2 then
					local s = 10 - dist / 10
					if s > bestScore then
						best, bestScore = p, s
					end
				end
			end
		end
	end
	if best then
		return best
	end

	-- 2) search parts around the location
	local ignore = { EspFolder }
	for _, p in ipairs(Players:GetPlayers()) do
		if p.Character then
			table.insert(ignore, p.Character)
		end
	end
	local params = OverlapParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = ignore
	params.MaxParts = 250

	local parts = Workspace:GetPartBoundsInRadius(pos, CONFIG.PickRadius, params)
	for _, part in ipairs(parts) do
		local s = scorePart(part, pos)
		if s > bestScore and s > 0 then
			best, bestScore = part, s
		end
	end
	return best
end

local function attemptPickup(pos)
	local char = LocalPlayer.Character
	local hrp = getRoot(char)
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not (hrp and hum and hum.Health > 0) then
		return false
	end

	local origCF = hrp.CFrame
	local got = false

	local function alive()
		return LocalPlayer.Character == char and hum.Health > 0 and hrp.Parent ~= nil
	end

	for _ = 1, CONFIG.PickRetries do
		if not alive() or not Settings.AutoPick or not Running then
			break
		end
		if not RS.PendingDrop then
			break -- somebody else has the gun now
		end

		-- move toward death / drop position
		hrp.CFrame = CFrame.new(pos + Vector3.new(0, 3, 0))
		hrp.AssemblyLinearVelocity = Vector3.zero
		task.wait(0.25)
		if not alive() then break end

		-- search and approach the pickup object
		local part = findPickup(pos)
		if part and part.Parent then
			hrp.CFrame = CFrame.new(part.Position + Vector3.new(0, 1.5, 0))
			hrp.AssemblyLinearVelocity = Vector3.zero
		end

		-- wait for the game's legitimate pickup system
		local t0 = os.clock()
		while os.clock() - t0 < 0.9 do
			task.wait(0.1)
			if not alive() then break end
			if hasGun(LocalPlayer) then
				got = true
				break
			end
			if part and not part.Parent then
				task.wait(0.3) -- target disappeared: check once more, then stop
				got = hasGun(LocalPlayer)
				break
			end
		end
		if got or not alive() then
			break
		end
		if part and not part.Parent then
			break
		end
		task.wait(0.3)
	end

	-- return to original location
	if alive() then
		hrp.CFrame = origCF
		hrp.AssemblyLinearVelocity = Vector3.zero
	end
	return got
end

local function pickStep()
	if not Settings.AutoPick then
		return
	end
	scanGunHolders()
	if AutoPickBusy or os.clock() - LastPickTime < CONFIG.PickCooldown then
		return
	end
	if not isAlive(LocalPlayer) or hasGun(LocalPlayer) then
		AutoPickStatus = hasGun(LocalPlayer) and "Gun equipped" or "Waiting"
		return
	end
	if not RS.PendingDrop or RS.PickPasses >= 2 then
		AutoPickStatus = "Waiting"
		AutoPickTargetText = "None"
		return
	end

	local pos, label = getTargetPosition()
	if not pos then
		return
	end

	AutoPickBusy = true
	AutoPickStatus = "Picking..."
	AutoPickTargetText = label
	RS.PickPasses += 1

	local got = false
	local ok = pcall(function()
		got = attemptPickup(pos)
	end)

	AutoPickBusy = false
	LastPickTime = os.clock()
	if ok and got then
		RS.PendingDrop = false
		AutoPickStatus = "Gun obtained"
	else
		AutoPickStatus = RS.PickPasses >= 2 and "Gave up (server did not give gun)" or "Retry soon"
	end
end

--==================================================
-- DRAGGING (mouse + touch, click-safe)
--==================================================
local function makeDraggable(handle, target, onClick)
	local dragging, moved = false, false
	local startInput, startPos, startMouse

	track(handle.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging, moved = true, false
			startInput = input
			startMouse = input.Position
			startPos = target.Position
			local c
			c = input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					c:Disconnect()
					if dragging then
						dragging = false
						if not moved and onClick then
							onClick()
						end
					end
				end
			end)
		end
	end))

	track(UserInputService.InputChanged:Connect(function(input)
		if not dragging then
			return
		end
		if input == startInput or input.UserInputType == Enum.UserInputType.MouseMovement then
			local delta = input.Position - startMouse
			if not moved and delta.Magnitude > 6 then
				moved = true
			end
			if moved and Gui then
				local size = Gui.AbsoluteSize
				if size.X > 0 and size.Y > 0 then
					local nx = math.clamp(startPos.X.Scale + delta.X / size.X, 0.03, 0.97)
					local ny = math.clamp(startPos.Y.Scale + delta.Y / size.Y, 0.03, 0.97)
					target.Position = UDim2.fromScale(nx, ny)
				end
			end
		end
	end))
end

