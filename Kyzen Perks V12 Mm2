-- ROUND DETECTION
--==================================================
local function resetRound()
	clearAllESP()
	RS = newRoundState()
	RoleCache = {}
	LastPositions = {}
	AutoPickStatus = Settings.AutoPick and "Waiting" or "Idle"
	AutoPickTargetText = "None"
end

local function readValue(container, name)
	local v = container:GetAttribute(name)
	if v ~= nil then
		return tostring(v)
	end
	local child = container:FindFirstChild(name)
	if child and child:IsA("ValueBase") then
		return tostring(child.Value)
	end
	return nil
end

local function collectContainers()
	local list = { Workspace, ReplicatedStorage }
	for _, root in ipairs({ Workspace, ReplicatedStorage }) do
		for _, c in ipairs(root:GetChildren()) do
			if c:IsA("Folder") or c:IsA("Configuration") then
				local n = string.lower(c.Name)
				if n:find("round") or n:find("game") or n:find("match") or n:find("state") or n:find("status") or n:find("data") then
					table.insert(list, c)
				end
			end
		end
	end
	return list
end

local IDLE_WORDS = { "intermission", "lobby", "wait", "end", "over", "finish", "vote", "idle", "cooldown", "waiting" }
local ACTIVE_WORDS = { "play", "active", "progress", "ingame", "running", "started", "round", "game", "match" }

local function classifyState(state)
	local s = normalize(state)
	for _, w in ipairs(IDLE_WORDS) do
		if s:find(w, 1, true) then return "idle" end
	end
	for _, w in ipairs(ACTIVE_WORDS) do
		if s:find(w, 1, true) then return "active" end
	end
	return "other"
end

local function detectRound()
	local containers = collectContainers()

	local ids = {}
	for _, name in ipairs(CONFIG.RoundIdNames) do
		for _, c in ipairs(containers) do
			local v = readValue(c, name)
			if v then
				table.insert(ids, name .. ":" .. v)
				break
			end
		end
	end
	local idSig = #ids > 0 and table.concat(ids, "|") or nil

	local state
	for _, name in ipairs(CONFIG.RoundStateNames) do
		for _, c in ipairs(containers) do
			local v = readValue(c, name)
			if v then
				state = v
				break
			end
		end
		if state then break end
	end

	local changed = false
	if idSig and RoundSig.id and idSig ~= RoundSig.id then
		changed = true
	end
	if idSig then
		RoundSig.id = idSig
	end

	if state then
		local norm = normalize(state)
		local cat = classifyState(state)
		if RoundSig.state and RoundSig.state ~= norm and cat ~= RoundSig.cat and (cat == "active" or cat == "idle") then
			changed = true
		end
		RoundSig.state = norm
		RoundSig.cat = cat
	end

	if changed then
		resetRound()
	end
end

local function refreshAllESP()
	detectRound()
	scanGunHolders()
	for _, p in ipairs(Players:GetPlayers()) do
		updateESP(p)
	end
	-- prune ESP for players that no longer exist
	for uid in pairs(ESPData) do
		if not Players:GetPlayerByUserId(uid) then
			destroyESP(uid)
		end
	end
	updateInfoLabels()
end

--==================================================
-- SHERIFF DEATH / LEAVE TRACKING
--==================================================
local function onPlayerDied(player, char)
	local uid = player.UserId
	local root = getRoot(char)
	local pos = (root and root.Position) or LastPositions[uid]
	destroyESP(uid)
	if not pos then
		return
	end
	if RS.SheriffId == uid then
		RS.LastSheriffDeathPosition = pos
		RS.SheriffDeathUserId = uid
		RS.SheriffDeathTime = os.clock()
		RS.LastGunHolderId = uid
		setPending()
	elseif RS.Heroes[uid] or RS.LastGunHolderId == uid then
		RS.GunHolderDeathPosition = pos
		RS.GunHolderDeathTime = os.clock()
		setPending()
	end
end

local function onPlayerLeaving(player)
	local uid = player.UserId
	local pos
	if isAlive(player) then
		local root = getRoot(player.Character)
		pos = (root and root.Position) or LastPositions[uid]
		if pos then
			if RS.SheriffId == uid then
				RS.LastSheriffDeathPosition = pos
				RS.SheriffDeathUserId = uid
				RS.SheriffDeathTime = os.clock()
				RS.LastGunHolderId = uid
				setPending()
			elseif RS.Heroes[uid] or RS.LastGunHolderId == uid then
				RS.GunHolderDeathPosition = pos
				RS.GunHolderDeathTime = os.clock()
				setPending()
			end
		end
	end
