--==================================================
-- ROLE DETECTION
--==================================================
local function roleFromString(v)
	local s = normalize(v)
	if s == "" or s == "nil" then
		return nil
	end
	if s:find("murder") or s:find("killer") then return "Murderer" end
	if s:find("sheriff") then return "Sheriff" end
	if s:find("hero") then return "Hero" end
	if s:find("innocent") or s:find("civilian") or s:find("bystander") then return "Innocent" end
	return nil
end

local BOOL_ROLE_FLAGS = {
	Murderer = "Murderer", IsMurderer = "Murderer",
	Sheriff = "Sheriff", IsSheriff = "Sheriff",
	Hero = "Hero", IsHero = "Hero",
}

local function getServerRole(player, char)
	-- 1) replicated attributes
	for _, name in ipairs(CONFIG.RoleAttributes) do
		local v = player:GetAttribute(name)
		if v == nil and char then
			v = char:GetAttribute(name)
		end
		if v ~= nil then
			local r = roleFromString(v)
			if r then return r end
		end
	end
	for flag, r in pairs(BOOL_ROLE_FLAGS) do
		if player:GetAttribute(flag) == true or (char and char:GetAttribute(flag) == true) then
			return r
		end
	end
	-- 2) team names
	if player.Team then
		local r = roleFromString(player.Team.Name)
		if r then return r end
	end
	-- 3) replicated role values
	for _, name in ipairs(CONFIG.RoleAttributes) do
		for _, holder in ipairs({ player, char }) do
			if holder then
				local obj = holder:FindFirstChild(name)
				if obj and obj:IsA("ValueBase") then
					local r = roleFromString(obj.Value)
					if r then return r end
				end
			end
		end
	end
	return nil
end

local function getRole(player, char)
	local uid = player.UserId

	local role = getServerRole(player, char)
	if role then
		if role == "Sheriff" and not RS.SheriffId then
			RS.SheriffId = uid
		elseif role == "Hero" then
			RS.Heroes[uid] = true
		end
		RoleCache[uid] = role
		return role
	end

	-- 4) knife evidence
	if hasKnife(player) then
		RoleCache[uid] = "Murderer"
		return "Murderer"
	end

	-- 5) gun evidence (first holder of the round = Sheriff, later holders = Hero)
	if hasGun(player) then
		if not RS.SheriffId then
			RS.SheriffId = uid
		end
		if RS.SheriffId == uid then
			role = "Sheriff"
		else
			RS.Heroes[uid] = true
			role = "Hero"
		end
		RoleCache[uid] = role
		return role
	end

	-- persistence (an unequipped gun is not replicated to other clients)
	if RS.SheriffId == uid then return "Sheriff" end
	if RS.Heroes[uid] then return "Hero" end
	local cached = RoleCache[uid]
	if cached and cached ~= "Innocent" then
		return cached
	end

	-- 6) fallback: Innocent (NEVER Murderer without evidence)
	return "Innocent"
end

