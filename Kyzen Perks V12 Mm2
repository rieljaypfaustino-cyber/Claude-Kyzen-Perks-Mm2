--==================================================
local function track(conn)
	table.insert(Connections, conn)
	return conn
end

local function create(class, props)
	local inst = Instance.new(class)
	local parent
	for k, v in pairs(props) do
		if k == "Parent" then
			parent = v
		else
			inst[k] = v
		end
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

local function corner(inst, radius)
	return create("UICorner", { CornerRadius = radius or UDim.new(0, 10), Parent = inst })
end

local function stroke(inst, color, thickness, transparency)
	return create("UIStroke", {
		Color = color or C.Line,
		Thickness = thickness or 1,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Parent = inst,
	})
end

local function gradient(inst, seq, rotation)
	return create("UIGradient", { Color = seq, Rotation = rotation or 0, Parent = inst })
end

local function tween(obj, time, props, style, dir)
	local t = TweenService:Create(
		obj,
		TweenInfo.new(time, style or Enum.EasingStyle.Quint, dir or Enum.EasingDirection.Out),
		props
	)
	t:Play()
	return t
end

local function spinGradient(grad, seconds)
	local t = TweenService:Create(
		grad,
		TweenInfo.new(seconds, Enum.EasingStyle.Linear, Enum.EasingDirection.In, -1),
		{ Rotation = grad.Rotation + 360 }
	)
	t:Play()
	return t
end

local function normalize(value)
	local s = string.lower(tostring(value))
	s = s:gsub("[%s_%-]", "")
	return s
end

local function containsAny(str, list)
	str = string.lower(str)
	for _, kw in ipairs(list) do
		if string.find(str, kw, 1, true) then
			return true
		end
	end
	return false
end

local function getRoot(char)
	return char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso"))
end

local function isAlive(player)
	local char = player and player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	return hum ~= nil and hum.Health > 0
end

--==================================================
-- ANIMATIONS (interactive button helper)
--==================================================
local function makeInteractive(btn, hover, press)
	hover = hover or 1.04
	press = press or 0.96
	local sc = btn:FindFirstChildOfClass("UIScale") or create("UIScale", { Parent = btn })
	local inside = false
	track(btn.MouseEnter:Connect(function()
		inside = true
		tween(sc, 0.15, { Scale = hover })
	end))
	track(btn.MouseLeave:Connect(function()
		inside = false
		tween(sc, 0.2, { Scale = 1 })
	end))
	track(btn.MouseButton1Down:Connect(function()
		tween(sc, 0.08, { Scale = press })
	end))
	track(btn.MouseButton1Up:Connect(function()
		tween(sc, 0.15, { Scale = inside and hover or 1 })
	end))
	return sc
end

--==================================================
-- GUN DETECTION (tool evidence + drop tracking)
--==================================================
local function isGunName(name)
	return containsAny(name, CONFIG.GunKeywords) and not containsAny(name, CONFIG.KnifeKeywords)
end

local function findToolMatching(player, keywords, excludes)
	local containers = { player.Character, player:FindFirstChildOfClass("Backpack") }
	for _, container in ipairs(containers) do
		if container then
			for _, tool in ipairs(container:GetChildren()) do
				if tool:IsA("Tool") then
					local n = string.lower(tool.Name)
					if containsAny(n, keywords) and not (excludes and containsAny(n, excludes)) then
						return tool
					end
				end
			end
		end
	end
	return nil
end

local function hasGun(player)
	return findToolMatching(player, CONFIG.GunKeywords, CONFIG.KnifeKeywords) ~= nil
end

local function hasKnife(player)
	return findToolMatching(player, CONFIG.KnifeKeywords, nil) ~= nil
end

local function isPlayerOwned(inst)
	if not inst:IsDescendantOf(Workspace) then
		return true
	end
	local p = inst.Parent
	while p and p ~= Workspace do
		if p:IsA("Backpack") or (p:IsA("Model") and p:FindFirstChildOfClass("Humanoid")) then
			return true
		end
		p = p.Parent
	end
	return false
end

local function getDropPart(inst)
	if inst:IsA("BasePart") then
		return inst
	elseif inst:IsA("Tool") then
		return inst:FindFirstChild("Handle") or inst:FindFirstChildWhichIsA("BasePart", true)
	elseif inst:IsA("Model") then
		return inst.PrimaryPart or inst:FindFirstChildWhichIsA("BasePart", true)
	end
	return nil
end

