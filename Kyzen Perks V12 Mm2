local function destroyESP(userId)
	local d = ESPData[userId]
	if d then
		if d.Billboard then d.Billboard:Destroy() end
		if d.Highlight then d.Highlight:Destroy() end
		ESPData[userId] = nil
	end
	if EspFolder then
		for _, c in ipairs(EspFolder:GetChildren()) do
			if c.Name == "KZ_BB_" .. userId or c.Name == "KZ_HL_" .. userId then
				c:Destroy()
			end
		end
	end
end

local function clearAllESP()
	for userId in pairs(ESPData) do
		destroyESP(userId)
	end
	if EspFolder then
		EspFolder:ClearAllChildren()
	end
	ESPData = {}
end

