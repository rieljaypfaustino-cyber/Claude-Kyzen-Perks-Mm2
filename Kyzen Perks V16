-- ROUND / PHASE DETECTION
--==================================================
local function captureAutoPickOrigin()
	if not Settings.AutoPick then return end
	local root = getRoot(LocalPlayer.Character)
	if root then
		AutoPickOriginCF = root.CFrame
	end
end

local function resetRound()
	clearAllESP()
	RS = newRoundState()
	RoleCache = {}
	LastPositions = {}
	NoEvidenceStreak = 0
	AutoPickStatus = Settings.AutoPick and "Waiting" or "Idle"
	AutoPickTargetText = "None"
end

local function readValue(container, name)
	local v = container:GetAttribute(name)
	if v ~= nil then return v end
	local child = container:FindFirstChild(name)
	if child and child:IsA("ValueBase") then return child.Value end
	return nil
end

local function collectContainers()
	local list = { Workspace, ReplicatedStorage }
	for _, root in ipairs({ Workspace, ReplicatedStorage }) do
		for _, c in ipairs(root:GetChildren()) do
			if c:IsA("Folder") or c:IsA("Configuration") then
				local n = string.lower(c.Name)
				if n:find("round") or n:find("game") or n:find("match") or n:find("state") or n:find("status") or n:find("data") then
					table.insert(list, c)
				end
			end
		end
	end
	return list
end

local IDLE_WORDS = { "intermission", "lobby", "wait", "vote", "idle" }
local ENDED_WORDS = { "end", "over", "finish", "result", "post" }
local COUNTDOWN_WORDS = { "countdown", "starting", "prep", "preround", "begin" }
local ACTIVE_WORDS = { "play", "active", "progress", "ingame", "running", "started", "round", "game", "match" }

local function classifyState(state)
	local s = normalize(state)
	for _, w in ipairs(COUNTDOWN_WORDS) do if s:find(w, 1, true) then return "Countdown" end end
	for _, w in ipairs(ENDED_WORDS) do if s:find(w, 1, true) then return "Ended" end end
	for _, w in ipairs(IDLE_WORDS) do if s:find(w, 1, true) then return "Lobby" end end
	for _, w in ipairs(ACTIVE_WORDS) do if s:find(w, 1, true) then return "Active" end end
	return nil
end

local function anyRoleEvidenceExists()
	for _, p in ipairs(Players:GetPlayers()) do
		if hasAnyRoleEvidence(p, p.Character) then
			return true
		end
	end
	return false
end

local function applyPhase(newPhase, idChanged)
	if newPhase == RoundPhase and not idChanged then return end
	local prev = RoundPhase
	RoundPhase = newPhase

	if newPhase == "Countdown" and prev ~= "Countdown" then
		resetRound()
	elseif idChanged and (newPhase == "Active" or newPhase == "Countdown") then
		resetRound()
	elseif (newPhase == "Lobby" or newPhase == "Ended") and prev ~= newPhase then
		resetRound()
		RoundPhase = newPhase
	end

	if newPhase == "Active" and Settings.AutoPick then
		-- fresh round just began while Auto Pick is on -> refresh the return anchor
		captureAutoPickOrigin()
	end
end

local function detectRound()
	local containers = collectContainers()

	local ids = {}
	for _, name in ipairs(CONFIG.RoundIdNames) do
		for _, c in ipairs(containers) do
			local v = readValue(c, name)
			if v ~= nil then table.insert(ids, name .. ":" .. tostring(v)); break end
		end
	end
	local idSig = #ids > 0 and table.concat(ids, "|") or nil

	local state
	for _, name in ipairs(CONFIG.RoundStateNames) do
		for _, c in ipairs(containers) do
			local v = readValue(c, name)
			if v ~= nil then state = tostring(v); break end
		end
		if state then break end
	end

	local countdownNum
	for _, name in ipairs(CONFIG.CountdownNames) do
		for _, c in ipairs(containers) do
			local v = readValue(c, name)
			if typeof(v) == "number" then countdownNum = v; break end
		end
		if countdownNum then break end
	end

	local newPhase = RoundPhase
	local stateCat = state and classifyState(state)
	local hadExplicitSignal = (stateCat ~= nil) or (countdownNum ~= nil)

	if stateCat then
		newPhase = stateCat
	elseif countdownNum ~= nil then
		if countdownNum > 0 and countdownNum <= CONFIG.CountdownSeconds + 0.5 then
			newPhase = "Countdown"
		elseif countdownNum <= 0 and RoundPhase == "Countdown" then
			newPhase = "Active"
		end
	end

	-- Heuristic fallback when the game has NO explicit round signals at all:
	if not hadExplicitSignal then
		local nearLobbyRatio = playersNearLobbyRatio()

		if RoundPhase == "Lobby" then
			if anyRoleEvidenceExists() then
				newPhase = "Active"
			elseif nearLobbyRatio and nearLobbyRatio < 0.4 then
				-- most players wandered away from the lobby spawn with no
				-- role evidence yet -> still treat as Lobby, do nothing
			end
		elseif RoundPhase == "Active" or RoundPhase == "Countdown" then
			if anyRoleEvidenceExists() then
				NoEvidenceStreak = 0
			else
				NoEvidenceStreak += 1
				local confirmedByLobby = (nearLobbyRatio ~= nil and nearLobbyRatio >= 0.5)
				if NoEvidenceStreak >= CONFIG.RoundEndEvidenceStreak or confirmedByLobby then
					newPhase = "Lobby"
					NoEvidenceStreak = 0
				end
			end
		end
	else
		NoEvidenceStreak = 0
	end

	RoundSig.countdownSeconds = (newPhase == "Countdown") and countdownNum or nil

	local idChanged = idSig and RoundSig.id and idSig ~= RoundSig.id
	if idSig then RoundSig.id = idSig end

	applyPhase(newPhase, idChanged)
end

local function currentEspInterval()
	if RoundPhase == "Countdown" then return CONFIG.EspRefreshCountdown end
	if RoundPhase == "Active" then return CONFIG.EspRefreshActive end
	return CONFIG.EspRefreshLobby
end

