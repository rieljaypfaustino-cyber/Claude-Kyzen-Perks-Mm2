-- SHERIFF / HERO DEATH TRACKING
--==================================================
local function onPlayerDied(player, char)
	local uid = player.UserId
	local root = getRoot(char)
	local pos = (root and root.Position) or LastPositions[uid]
	destroyESP(uid)

	if player == LocalPlayer then
		AutoPickBusy = false
		AutoPickStatus = "Idle (you died)"
		AutoPickTargetText = "None"
	end

	if not pos then return end
	if RS.SheriffId == uid then
		RS.LastSheriffDeathPosition = pos
		RS.SheriffDeathUserId = uid
		RS.SheriffDeathTime = os.clock()
		RS.LastGunHolderId = uid
		setPending()
	elseif RS.CurrentHeroId == uid or RS.LastGunHolderId == uid then
		RS.GunHolderDeathPosition = pos
		RS.GunHolderDeathTime = os.clock()
		setPending()
	end
end

local function onPlayerLeaving(player)
	local uid = player.UserId
	local pos
	if isAlive(player) then
		local root = getRoot(player.Character)
		pos = (root and root.Position) or LastPositions[uid]
		if pos then
			if RS.SheriffId == uid then
				RS.LastSheriffDeathPosition = pos
				RS.SheriffDeathUserId = uid
				RS.SheriffDeathTime = os.clock()
				RS.LastGunHolderId = uid
				setPending()
			elseif RS.CurrentHeroId == uid or RS.LastGunHolderId == uid then
				RS.GunHolderDeathPosition = pos
				RS.GunHolderDeathTime = os.clock()
				setPending()
			end
		end
	end
	destroyESP(uid)
	LastPositions[uid] = nil
end

--==================================================
-- AUTO PICK  (faster teleport, returns to the pre-activation origin)
--==================================================
local function considerDrop(inst, fresh)
	if not (inst:IsA("Tool") or inst:IsA("BasePart") or inst:IsA("Model")) then return end
	if not isGunName(inst.Name) then return end
	if inst:IsA("Model") and inst:FindFirstChildOfClass("Humanoid") then return end
	if isPlayerOwned(inst) then return end
	GunDrops[inst] = true
	if fresh and inst:IsA("Tool") and RS.SheriffId then
		setPending()
	end
end

local function startDropWatch()
	if next(DropConns) then return end
	for _, inst in ipairs(Workspace:GetDescendants()) do
		considerDrop(inst, false)
	end
	DropConns.Added = Workspace.DescendantAdded:Connect(function(inst) considerDrop(inst, true) end)
	DropConns.Removing = Workspace.DescendantRemoving:Connect(function(inst) GunDrops[inst] = nil end)
end

local function stopDropWatch()
	for k, conn in pairs(DropConns) do
		conn:Disconnect()
		DropConns[k] = nil
	end
	GunDrops = {}
end

local function getTargetPosition()
	if not RS.PendingDrop then return nil end
	local sPos, gPos = RS.LastSheriffDeathPosition, RS.GunHolderDeathPosition
	if sPos and (not gPos or RS.SheriffDeathTime >= RS.GunHolderDeathTime) then
		return sPos, "Last Sheriff death spot"
	elseif gPos then
		return gPos, "Last Hero death spot"
	end
	if RS.LastGunHolderPos then
		return RS.LastGunHolderPos, "Last known gun holder"
	end
	for inst in pairs(GunDrops) do
		if inst.Parent then
			local part = getDropPart(inst)
			if part then return part.Position, "Detected floating gun" end
		end
	end
	return nil
end

local function scorePart(part, pos)
	if part.Size.Magnitude > 20 or not part.CanTouch then return -1 end
	local score, evidence = 0, false
	local tool = part:FindFirstAncestorOfClass("Tool")
	local model = part:FindFirstAncestorOfClass("Model")

	if isGunName(part.Name) or (tool and isGunName(tool.Name)) or (model and isGunName(model.Name)) then
		score += 6; evidence = true
	end
	if tool then score += 4; evidence = true end
	if model then
		local n = 0
		for _, child in ipairs(model:GetChildren()) do
			n += 1
			if n > 30 then break end
			if isGunName(child.Name) then score += 3; evidence = true; break end
		end
	end
	for k in pairs(part:GetAttributes()) do
		if isGunName(k) then score += 3; evidence = true; break end
	end
	if part.Anchored or part:FindFirstChildOfClass("TouchTransmitter") then
		score += 2 -- floating / touch-enabled pickup indicator
	end
	if not evidence then return -1 end
	return score - (part.Position - pos).Magnitude / 25
end

-- Smart floating-object search: checks known drop instances first, then does
-- a live radius scan (fast - re-run on every approach tick, not just once).
local function findPickup(pos)
	local best, bestScore = nil, -math.huge
	for inst in pairs(GunDrops) do
		if inst.Parent then
			local p = getDropPart(inst)
			if p then
				local dist = (p.Position - pos).Magnitude
				if dist <= CONFIG.PickRadius * 2 then
					local s = 10 - dist / 10
					if s > bestScore then best, bestScore = p, s end
				end
			end
		end
	end
	if best then return best end

	local ignore = { EspFolder }
	for _, p in ipairs(Players:GetPlayers()) do
		if p.Character then table.insert(ignore, p.Character) end
	end
	local params = OverlapParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = ignore
	params.MaxParts = 250

	local parts = Workspace:GetPartBoundsInRadius(pos, CONFIG.PickRadius, params)
	for _, part in ipairs(parts) do
		local s = scorePart(part, pos)
		if s > bestScore and s > 0 then best, bestScore = part, s end
	end
	return best
end

local function attemptPickup(pos)
	local char = LocalPlayer.Character
	local hrp = getRoot(char)
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not (hrp and hum and hum.Health > 0) then return false end

	-- Always return to the anchor saved when Auto Pick was activated (or the
	-- start of this round), not just "wherever I currently am".
	local returnCF = AutoPickOriginCF or hrp.CFrame
	local got = false

	local function alive()
		return LocalPlayer.Character == char and hum.Health > 0 and hrp.Parent ~= nil
	end

	for _ = 1, CONFIG.PickRetries do
		if not alive() or not Settings.AutoPick or not Running or RoundPhase ~= "Active" then break end
		if not RS.PendingDrop then break end

		-- fast teleport toward the last death / drop position
		hrp.CFrame = CFrame.new(pos + Vector3.new(0, 3, 0))
		hrp.AssemblyLinearVelocity = Vector3.zero
		task.wait(0.1)
		if not alive() then break end

		-- re-scan and hop right onto the floating gun (touch range)
		local part = findPickup(pos)
		if part and part.Parent then
			hrp.CFrame = CFrame.new(part.Position + Vector3.new(0, 1.3, 0))
			hrp.AssemblyLinearVelocity = Vector3.zero
		end

		-- wait for the game's legitimate touch/pickup system, re-checking fast
		local t0 = os.clock()
		while os.clock() - t0 < 0.6 do
			task.wait(0.08)
			if not alive() then break end
			if hasGun(LocalPlayer) then got = true; break end
			if part and not part.Parent then
				-- object vanished (someone else grabbed it, or we got it) - re-scan once more
				local retry = findPickup(pos)
				if retry and retry.Parent and retry ~= part then
					part = retry
					hrp.CFrame = CFrame.new(part.Position + Vector3.new(0, 1.3, 0))
				else
					task.wait(0.15)
					got = hasGun(LocalPlayer)
					break
				end
			end
		end
		if got or not alive() then break end
		if part and not part.Parent then break end
		task.wait(0.15)
	end

	if alive() then
		hrp.CFrame = returnCF
		hrp.AssemblyLinearVelocity = Vector3.zero
	end
	return got
end

local function pickStep()
	if not Settings.AutoPick then return end
	if RoundPhase ~= "Active" then
		AutoPickBusy = false
		AutoPickStatus = (RoundPhase == "Lobby") and "Idle (Lobby)" or "Waiting for round"
		AutoPickTargetText = "None"
		return
	end
	scanGunHolders()
	if AutoPickBusy or os.clock() - LastPickTime < CONFIG.PickCooldown then return end
	if not isAlive(LocalPlayer) then
		AutoPickStatus = "Idle (you're dead)"
		return
	end
	if hasGun(LocalPlayer) then
		AutoPickStatus = "Gun equipped"
		return
	end
	if not RS.SheriffId or not RS.PendingDrop or RS.PickPasses >= 2 then
		AutoPickStatus = "Waiting"
		AutoPickTargetText = "None"
		return
	end
	if not AutoPickOriginCF then
		captureAutoPickOrigin()
	end

	local pos, label = getTargetPosition()
	if not pos then return end

	AutoPickBusy = true
	AutoPickStatus = "Picking..."
	AutoPickTargetText = label
	RS.PickPasses += 1

	local got = false
	local ok = pcall(function() got = attemptPickup(pos) end)

	AutoPickBusy = false
	LastPickTime = os.clock()
	if ok and got then
		RS.PendingDrop = false
		AutoPickStatus = "Gun obtained"
	else
		AutoPickStatus = RS.PickPasses >= 2 and "Gave up (server did not give gun)" or "Retry soon"
	end
end

