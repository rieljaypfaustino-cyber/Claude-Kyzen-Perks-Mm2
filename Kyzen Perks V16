local function track(conn)
	table.insert(Connections, conn)
	return conn
end

local function create(class, props)
	local inst = Instance.new(class)
	local parent
	for k, v in pairs(props) do
		if k == "Parent" then
			parent = v
		else
			inst[k] = v
		end
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

local function corner(inst, radius)
	return create("UICorner", { CornerRadius = radius or UDim.new(0, 10), Parent = inst })
end

local function stroke(inst, color, thickness, transparency)
	return create("UIStroke", {
		Color = color or C.Line,
		Thickness = thickness or 1,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Parent = inst,
	})
end

local function gradient(inst, seq, rotation)
	return create("UIGradient", { Color = seq, Rotation = rotation or 0, Parent = inst })
end

local function tween(obj, time, props, style, dir)
	local t = TweenService:Create(
		obj,
		TweenInfo.new(time, style or Enum.EasingStyle.Quint, dir or Enum.EasingDirection.Out),
		props
	)
	t:Play()
	return t
end

local function spinGradient(grad, seconds)
	local t = TweenService:Create(
		grad,
		TweenInfo.new(seconds, Enum.EasingStyle.Linear, Enum.EasingDirection.In, -1),
		{ Rotation = grad.Rotation + 360 }
	)
	t:Play()
	return t
end

local function pulse(obj, prop, a, b, seconds)
	local goal = {}
	goal[prop] = b
	local t = TweenService:Create(
		obj,
		TweenInfo.new(seconds, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
		goal
	)
	t:Play()
	return t
end

local function normalize(value)
	local s = string.lower(tostring(value))
	s = s:gsub("[%s_%-]", "")
	return s
end

local function containsAny(str, list)
	str = string.lower(str)
	for _, kw in ipairs(list) do
		if string.find(str, kw, 1, true) then
			return true
		end
	end
	return false
end

local function getRoot(char)
	return char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso"))
end

local function isAlive(player)
	local char = player and player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	return hum ~= nil and hum.Health > 0
end

--==================================================
-- LOBBY SPAWN DETECTION
--==================================================
-- Scans the whole Workspace for SpawnLocation instances. Prefers one whose
-- name/parent hints at "lobby"; otherwise falls back to the first spawn found.
-- Its position is used as extra confirmation that players are in the Lobby
-- area (helps the Unassigned/white ESP trigger correctly).
local function findLobbySpawn()
	local best, bestScore = nil, -math.huge
	for _, inst in ipairs(Workspace:GetDescendants()) do
		if inst:IsA("SpawnLocation") then
			local score = 0
			local n = string.lower(inst.Name)
			local pn = inst.Parent and string.lower(inst.Parent.Name) or ""
			if n:find("lobby") or pn:find("lobby") then
				score += 10
			end
			if n:find("spawn") then
				score += 1
			end
			if inst.Neutral then
				score += 2 -- neutral spawns are usually lobby spawns, not team spawns
			end
			if score > bestScore then
				best, bestScore = inst, score
			end
		end
	end
	if best then
		LobbySpawnPos = best.Position
	end
end

local function isNearLobby(pos)
	if not LobbySpawnPos or not pos then
		return false
	end
	return (Vector3.new(pos.X, LobbySpawnPos.Y, pos.Z) - LobbySpawnPos).Magnitude <= CONFIG.LobbySearchRadius
end

local function playersNearLobbyRatio()
	if not LobbySpawnPos then
		return nil
	end
	local total, near = 0, 0
	for _, p in ipairs(Players:GetPlayers()) do
		local root = getRoot(p.Character)
		if root then
			total += 1
			if isNearLobby(root.Position) then
				near += 1
			end
		end
	end
	if total == 0 then
		return nil
	end
	return near / total
end

