local function makeCard(parent, height, order)
	local f = create("Frame", {
		Size = UDim2.new(1, -4, 0, height), BackgroundColor3 = C.Card, BorderSizePixel = 0,
		LayoutOrder = order or 0, Parent = parent,
	})
	corner(f, UDim.new(0, 10))
	local st = stroke(f, C.Line, 1, 0.2)
	spinGradient(gradient(f, LIGHT_SEQ, 90), 14)
	return f, st
end

local function makeText(parent, props)
	local t = {
		BackgroundTransparency = 1, Font = Enum.Font.Gotham, TextColor3 = C.TextDark,
		TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left, Parent = parent,
	}
	for k, v in pairs(props) do t[k] = v end
	return create("TextLabel", t)
end

local function makeToggleRow(parent, order, title, default, onChange)
	local row = makeCard(parent, 58, order)
	makeText(row, {
		Position = UDim2.fromOffset(12, 8), Size = UDim2.fromOffset(190, 18),
		Text = title, Font = Enum.Font.GothamBold, TextSize = 14,
	})
	local status = makeText(row, {
		Position = UDim2.fromOffset(12, 30), Size = UDim2.fromOffset(120, 18),
		Text = "● OFF", Font = Enum.Font.GothamBold, TextSize = 12, TextColor3 = C.Red,
	})
	local switch = create("TextButton", {
		AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0),
		Size = UDim2.fromOffset(52, 26), BackgroundColor3 = C.RedSoft, Text = "",
		AutoButtonColor = false, Parent = row,
	})
	corner(switch, UDim.new(1, 0))
	local tStroke = stroke(switch, C.Red, 1.5, 0.1)
	local knob = create("Frame", {
		AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 3, 0.5, 0),
		Size = UDim2.fromOffset(20, 20), BackgroundColor3 = C.White, BorderSizePixel = 0, Parent = switch,
	})
	corner(knob, UDim.new(1, 0))
	stroke(knob, C.Line, 1, 0.4)
	makeInteractive(switch, 1.06, 0.94)

	local state = default
	local function apply(animate)
		local dur = animate and 0.25 or 0
		tween(switch, dur, { BackgroundColor3 = state and C.BlueSoft or C.RedSoft })
		tween(tStroke, dur, { Color = state and C.Blue or C.Red })
		tween(knob, dur, { Position = state and UDim2.new(1, -23, 0.5, 0) or UDim2.new(0, 3, 0.5, 0) }, Enum.EasingStyle.Back)
		status.Text = state and "● ON" or "● OFF"
		tween(status, dur, { TextColor3 = state and C.Blue or C.Red })
	end
	apply(false)

	switch.Activated:Connect(function()
		state = not state
		apply(true)
		onChange(state)
	end)
	return row
end

