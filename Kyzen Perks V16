local function hookCharacter(player, char)
	destroyESP(player.UserId)
	task.spawn(function()
		local hum = char:WaitForChild("Humanoid", 8)
		if not hum or not Running then return end
		local conns = PlayerConns[player.UserId]
		if conns then
			table.insert(conns, hum.Died:Connect(function() onPlayerDied(player, char) end))
		end
		task.wait(0.4)
		if Running then pcall(updateESP, player) end
	end)
end

local function hookPlayer(player)
	local uid = player.UserId
	if PlayerConns[uid] then return end
	local conns = {}
	PlayerConns[uid] = conns
	table.insert(conns, player.CharacterAdded:Connect(function(char) hookCharacter(player, char) end))
	table.insert(conns, player.CharacterRemoving:Connect(function() destroyESP(uid) end))
	if player.Character then hookCharacter(player, player.Character) end
end

local function unhookPlayer(player)
	local uid = player.UserId
	onPlayerLeaving(player)
	local conns = PlayerConns[uid]
	if conns then
		for _, c in ipairs(conns) do c:Disconnect() end
		PlayerConns[uid] = nil
	end
	RoleCache[uid] = nil
end

local function startEvents()
	track(Players.PlayerAdded:Connect(hookPlayer))
	track(Players.PlayerRemoving:Connect(unhookPlayer))
	for _, p in ipairs(Players:GetPlayers()) do hookPlayer(p) end

	findLobbySpawn()

	local function onViewport()
		computeScales()
		if UI.LoadScale and UI.Loading and UI.Loading.Parent then UI.LoadScale.Scale = loadScaleValue end
		if UI.MainScale and mainOpen then UI.MainScale.Scale = baseScale end
	end
	local function hookCamera()
		local cam = Workspace.CurrentCamera
		if cam then track(cam:GetPropertyChangedSignal("ViewportSize"):Connect(onViewport)) end
		onViewport()
	end
	track(Workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(hookCamera))
	hookCamera()
end

--==================================================
-- MAIN LOOPS
--==================================================
local function startLoops()
	if loopsStarted then return end
	loopsStarted = true

	task.spawn(function()
		while Running do
			local ok, err = pcall(refreshAllESP)
			if not ok then warn("[KyzenPerks] ESP error: " .. tostring(err)) end
			task.wait(currentEspInterval())
		end
	end)

	task.spawn(function()
		while Running do
			pcall(updateDistances)
			task.wait(CONFIG.DistanceRefresh)
		end
	end)

	task.spawn(function()
		while Running do
			if Settings.AutoPick then
				local ok, err = pcall(pickStep)
				if not ok then
					AutoPickBusy = false
					warn("[KyzenPerks] AutoPick error: " .. tostring(err))
				end
			end
			task.wait(CONFIG.GunScan)
		end
	end)
end

--==================================================
-- CLEANUP
--==================================================
local function cleanup()
	Running = false
	for _, c in ipairs(Connections) do pcall(function() c:Disconnect() end) end
	Connections = {}
	for _, conns in pairs(PlayerConns) do
		for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
	end
	PlayerConns = {}
	stopDropWatch()
	clearAllESP()
	clearGunESP()
	RS = newRoundState()
	if EspFolder then EspFolder:Destroy() end
	if Gui then Gui:Destroy() end
end
_G.KyzenPerksCleanup = cleanup

--==================================================
-- BOOT SEQUENCE
--==================================================
buildLoading()
tween(UI.Loading, 0.4, { GroupTransparency = 0 })

local initDone = false
task.spawn(function()
	local ok, err = pcall(function()
		task.wait(0.2)
		buildMain()
		task.wait(0.1)
		buildToggle()
		task.wait(0.1)
		startEvents()
		startLoops()
	end)
	if not ok then warn("[KyzenPerks] Init error: " .. tostring(err)) end
	initDone = true
end)

do
	local t0 = os.clock()
	local shown = 0
	while Running do
		RunService.Heartbeat:Wait()
		local a = math.clamp((os.clock() - t0) / CONFIG.LoadingTime, 0, 1)
		local eased = a < 0.5 and 2 * a * a or 1 - ((-2 * a + 2) ^ 2) / 2
		if not initDone then eased = math.min(eased, 0.95) end
		shown = math.max(shown, eased)
		local pct = math.floor(shown * 100 + 0.5)
		UI.Fill.Size = UDim2.fromScale(shown, 1)
		UI.Percent.Text = pct .. "%"
		UI.Stage.Text = stageText(pct)
		if shown >= 1 then break end
	end
end

if Running then
	task.wait(0.3)
	local fade = tween(UI.Loading, 0.5, { GroupTransparency = 1 })
	tween(UI.LoadScale, 0.5, { Scale = loadScaleValue * 0.92 })
	if UI.Main then openMain() end
	if UI.ToggleHolder then UI.ToggleHolder.Visible = true end
	fade.Completed:Connect(function()
		if UI.Loading then
			UI.Loading:Destroy()
			UI.Loading = nil
		end
	end)
end
