-- DROPPED GUN ESP  (own ON/OFF toggle, live distance)
--==================================================
local function destroyGunESPFor(inst)
	local d = GunESPData[inst]
	if d then
		if d.Billboard then d.Billboard:Destroy() end
		if d.Highlight then d.Highlight:Destroy() end
		GunESPData[inst] = nil
	end
end

local function clearGunESP()
	for inst in pairs(GunESPData) do destroyGunESPFor(inst) end
end

local function createGunESP(part)
	local bb = create("BillboardGui", {
		Name = "KZ_GUNBB", Adornee = part, Size = UDim2.fromOffset(130, 40),
		StudsOffset = Vector3.new(0, 1.8, 0), AlwaysOnTop = true, LightInfluence = 0, Parent = EspFolder,
	})
	create("UIListLayout", {
		SortOrder = Enum.SortOrder.LayoutOrder, HorizontalAlignment = Enum.HorizontalAlignment.Center,
		VerticalAlignment = Enum.VerticalAlignment.Center, Padding = UDim.new(0, 1), Parent = bb,
	})
	local titleL = espLabel(bb, 1, "Dropped Gun", 13, Enum.Font.GothamBold, GUN_ESP_COLOR, 15)
	local distL = espLabel(bb, 2, "0 studs", 11, Enum.Font.GothamBold, C.White, 13)

	local hl = create("Highlight", {
		Name = "KZ_GUNHL", Adornee = part, DepthMode = Enum.HighlightDepthMode.AlwaysOnTop,
		FillColor = GUN_ESP_COLOR, OutlineColor = GUN_ESP_COLOR, FillTransparency = 0.4, OutlineTransparency = 0,
		Parent = EspFolder,
	})
	GunESPData[part] = { Billboard = bb, Highlight = hl, DistLabel = distL }
end

local function refreshGunESP()
	if not Settings.GunESP or RoundPhase ~= "Active" or not RS.PendingDrop then
		clearGunESP()
		return
	end
	local pos = getTargetPosition()
	if not pos then
		clearGunESP()
		return
	end
	local part = findPickup(pos)
	for inst in pairs(GunESPData) do
		if inst ~= part or not inst.Parent then
			destroyGunESPFor(inst)
		end
	end
	if part and part.Parent and not GunESPData[part] then
		createGunESP(part)
	end
end

local function refreshAllESP()
	detectRound()
	if not Settings.ESP then
		clearAllESP()
	else
		if RoundPhase ~= "Lobby" then
			scanGunHolders()
		end
		for _, p in ipairs(Players:GetPlayers()) do
			updateESP(p)
		end
		for uid in pairs(ESPData) do
			if not Players:GetPlayerByUserId(uid) then
				destroyESP(uid)
			end
		end
	end
	refreshGunESP()
	updateInfoLabels()
end

--==================================================
-- DRAGGING + CLICK
--==================================================
local function makeDraggable(handle, target, onClick)
	local dragging, moved = false, false
	local startPos, startMouse
	local DRAG_THRESHOLD = 6

	track(handle.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			moved = false
			startMouse = input.Position
			startPos = target.Position
		end
	end))

	track(UserInputService.InputChanged:Connect(function(input)
		if not dragging then return end
		if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
			local delta = input.Position - startMouse
			if not moved and delta.Magnitude > DRAG_THRESHOLD then moved = true end
			if moved and Gui then
				local size = Gui.AbsoluteSize
				if size.X > 0 and size.Y > 0 then
					local nx = math.clamp(startPos.X.Scale + delta.X / size.X, 0.03, 0.97)
					local ny = math.clamp(startPos.Y.Scale + delta.Y / size.Y, 0.03, 0.97)
					target.Position = UDim2.fromScale(nx, ny)
				end
			end
		end
	end))

	track(UserInputService.InputEnded:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
			dragging = false
		end
	end))

	if onClick and handle:IsA("GuiButton") then
		track(handle.Activated:Connect(function()
			if not moved then onClick() end
		end))
	end
end

