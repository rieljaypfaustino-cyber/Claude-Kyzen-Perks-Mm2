--==================================================
-- ROLE DETECTION
--==================================================
local function roleFromString(v)
	local s = normalize(v)
	if s == "" or s == "nil" then return nil end
	if s:find("murder") or s:find("killer") then return "Murderer" end
	if s:find("sheriff") then return "Sheriff" end
	if s:find("hero") then return "Hero" end
	if s:find("innocent") or s:find("civilian") or s:find("bystander") then return "Innocent" end
	return nil
end

local BOOL_ROLE_FLAGS = {
	Murderer = "Murderer", IsMurderer = "Murderer",
	Sheriff = "Sheriff", IsSheriff = "Sheriff",
	Hero = "Hero", IsHero = "Hero",
}

local function getServerRole(player, char)
	for _, name in ipairs(CONFIG.RoleAttributes) do
		local v = player:GetAttribute(name)
		if v == nil and char then
			v = char:GetAttribute(name)
		end
		if v ~= nil then
			local r = roleFromString(v)
			if r then return r end
		end
	end
	for flag, r in pairs(BOOL_ROLE_FLAGS) do
		if player:GetAttribute(flag) == true or (char and char:GetAttribute(flag) == true) then
			return r
		end
	end
	if player.Team then
		local r = roleFromString(player.Team.Name)
		if r then return r end
	end
	for _, name in ipairs(CONFIG.RoleAttributes) do
		for _, holder in ipairs({ player, char }) do
			if holder then
				local obj = holder:FindFirstChild(name)
				if obj and obj:IsA("ValueBase") then
					local r = roleFromString(obj.Value)
					if r then return r end
				end
			end
		end
	end
	return nil
end

local function hasAnyRoleEvidence(player, char)
	if player.Team and roleFromString(player.Team.Name) then return true end
	for _, name in ipairs(CONFIG.RoleAttributes) do
		if player:GetAttribute(name) ~= nil then return true end
		if char and char:GetAttribute(name) ~= nil then return true end
	end
	if hasGun(player) or hasKnife(player) then return true end
	return false
end

--[[
    getRole(player, char)

    LOBBY        -> "Unassigned" (white), always.
    COUNTDOWN    -> uses the game's own assigned role the moment it appears.
    ACTIVE ROUND -> tool-evidence based (checks BOTH equipped char AND Backpack):
        * Sheriff   = FIRST gun-tool holder of the round (locked to that uid).
        * Hero      = any LATER gun-tool holder (someone who picked up the
                      dropped gun after the Sheriff already existed).
        * Murderer  = server role says Murderer (if the game exposes it), OR,
                      if the game exposes nothing, the FIRST knife-tool holder
                      of the round (locked to that uid) - this is what stops
                      multiple players being tagged Murderer at once.
        * Innocent  = no gun tool and no knife tool -> default/fallback.
    Sheriff/Hero/Murderer identity persists across brief tool unequips.
]]
local function getRole(player, char)
	local uid = player.UserId

	if RoundPhase == "Lobby" then
		return "Unassigned"
	end

	if RoundPhase == "Countdown" then
		local serverRole = getServerRole(player, char)
		if serverRole then
			if serverRole == "Sheriff" and not RS.SheriffId then
				RS.SheriffId = uid
			elseif serverRole == "Murderer" and not RS.MurdererId then
				RS.MurdererId = uid
			elseif serverRole == "Hero" then
				RS.Heroes[uid] = true
				RS.CurrentHeroId = uid
			end
			RoleCache[uid] = serverRole
			return serverRole
		end
		return RoleCache[uid] or "Unassigned"
	end

	-- ACTIVE (or Ended, briefly, before reset clears it)
	local serverRole = getServerRole(player, char)
	local gunTool = hasGun(player)
	local knifeTool = hasKnife(player)

	if gunTool then
		if not RS.SheriffId then
			RS.SheriffId = uid
			RoleCache[uid] = "Sheriff"
			return "Sheriff"
		elseif RS.SheriffId == uid then
			RoleCache[uid] = "Sheriff"
			return "Sheriff"
		else
			RS.Heroes[uid] = true
			RS.CurrentHeroId = uid
			RoleCache[uid] = "Hero"
			return "Hero"
		end
	end

	if knifeTool then
		if serverRole == "Murderer" then
			RS.MurdererId = uid
			RoleCache[uid] = "Murderer"
			return "Murderer"
		elseif serverRole == nil then
			-- No server role exposed: lock Murderer to the FIRST knife
			-- holder only, so a second decorative/knife-named tool on
			-- another player never creates a second "Murderer" ESP.
			if not RS.MurdererId then
				RS.MurdererId = uid
			end
			if RS.MurdererId == uid then
				RoleCache[uid] = "Murderer"
				return "Murderer"
			end
		end
	end

	-- Persist identity through a brief tool unequip
	if RS.SheriffId == uid then return "Sheriff" end
	if RS.CurrentHeroId == uid then return "Hero" end
	if RS.MurdererId == uid then return "Murderer" end

	RoleCache[uid] = "Innocent"
	return "Innocent"
end

