local function updateESP(player)
	if player == LocalPlayer then
		return
	end
	local uid = player.UserId
	if not Settings.ESP then
		destroyESP(uid)
		return
	end

	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local head = char and char:FindFirstChild("Head")
	if not (char and hum and head) or hum.Health <= 0 then
		destroyESP(uid)
		return
	end

	local root = getRoot(char)
	if root then
		LastPositions[uid] = root.Position
	end

	local role = getRole(player, char)

	local d = ESPData[uid]
	if d and (d.Character ~= char or not d.Billboard.Parent or d.Billboard.Adornee ~= head) then
		destroyESP(uid)
		d = nil
	end
	if not d then
		d = createESP(player, char, role)
	end
	if d and d.Role ~= role then
		local color = ROLE_COLORS[role] or ROLE_COLORS.Unassigned
		d.Role = role
		d.RoleLabel.Text = role
		d.RoleLabel.TextColor3 = color
		d.Highlight.FillColor = color
		d.Highlight.OutlineColor = color
	end
end

local function updateDistances()
	local myRoot = getRoot(LocalPlayer.Character)
	if not myRoot then return end
	for uid, d in pairs(ESPData) do
		local root = getRoot(d.Character)
		if root and d.DistLabel and d.DistLabel.Parent then
			d.DistLabel.Text = math.floor((root.Position - myRoot.Position).Magnitude + 0.5) .. " studs"
		end
	end
	for inst, d in pairs(GunESPData) do
		if inst.Parent and d.DistLabel and d.DistLabel.Parent then
			d.DistLabel.Text = math.floor((inst.Position - myRoot.Position).Magnitude + 0.5) .. " studs"
		end
	end
end

local PHASE_LABEL = {
	Lobby = "Lobby", Countdown = "Starting soon", Active = "In progress", Ended = "Round ended",
}

local function updateInfoLabels()
	if not UI.SheriffLabel then return end
	local sheriff = RS.SheriffId and Players:GetPlayerByUserId(RS.SheriffId)
	UI.SheriffLabel.Text = "Sheriff:  " .. (sheriff and sheriff.DisplayName or "-")

	local hero = RS.CurrentHeroId and Players:GetPlayerByUserId(RS.CurrentHeroId)
	UI.HeroLabel.Text = "Hero:  " .. (hero and hero.DisplayName or "-")

	local phaseText = PHASE_LABEL[RoundPhase] or RoundPhase
	if RoundPhase == "Countdown" and RoundSig.countdownSeconds then
		phaseText = phaseText .. string.format("  (%ds)", math.max(0, math.floor(RoundSig.countdownSeconds)))
	end
	UI.RoundLabel.Text = "Round:  " .. phaseText

	if UI.PickStatus then
		UI.PickStatus.Text = "Status:  " .. AutoPickStatus
		UI.PickTarget.Text = "Target:  " .. AutoPickTargetText
	end
end

