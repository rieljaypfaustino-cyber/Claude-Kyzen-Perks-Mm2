local baseScale, loadScaleValue = 1, 1
local function computeScales()
	local cam = Workspace.CurrentCamera
	local vp = cam and cam.ViewportSize or Vector2.new(1280, 720)
	baseScale = math.clamp(math.min(vp.X * 0.94 / 470, vp.Y * 0.9 / 300), 0.55, 1.15)
	loadScaleValue = math.clamp(math.min(vp.X * 0.9 / 330, vp.Y * 0.8 / 150), 0.6, 1.2)
end
computeScales()

local mainOpen, mainToken = false, 0

local function openMain()
	if mainOpen or not UI.Main then return end
	mainOpen = true
	mainToken += 1
	UI.Main.Visible = true
	UI.Main.GroupTransparency = 1
	UI.MainScale.Scale = baseScale * 0.86
	tween(UI.Main, 0.35, { GroupTransparency = 0 })
	tween(UI.MainScale, 0.4, { Scale = baseScale }, Enum.EasingStyle.Back)
end

local function closeMain()
	if not mainOpen or not UI.Main then return end
	mainOpen = false
	mainToken += 1
	local tok = mainToken
	local t = tween(UI.Main, 0.25, { GroupTransparency = 1 })
	tween(UI.MainScale, 0.25, { Scale = baseScale * 0.88 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	t.Completed:Connect(function()
		if mainToken == tok and UI.Main then UI.Main.Visible = false end
	end)
end

